# Shared
NODE_ENV=development

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Backend
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/smart_feedback?schema=public
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
NLP_SERVICE_URL=http://nlp-service:8000

# NLP service
# Use demo for lightweight local testing.
# Use llama or malaysian-llama to run mesolitica/Malaysian-Llama-3.2-3B-Instruct.
NLP_MODE=demo
LLM_MODEL_NAME=mesolitica/Malaysian-Llama-3.2-3B-Instruct
LLM_DEVICE=auto
LLM_TORCH_DTYPE=auto
LLM_MAX_INPUT_TOKENS=2048
LLM_MAX_NEW_TOKENS=256
LLM_TEMPERATURE=0.0

# Optional legacy/future classifier adapter paths
CATEGORY_MODEL_PATH=./models/category-malaysian-llama-adapter
URGENCY_MODEL_PATH=./models/urgency-malaysian-llama-adapter
SENTIMENT_MODEL_PATH=./models/sentiment-malaysian-llama-adapter

# Embeddings and Pinecone
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
PINECONE_API_KEY=
PINECONE_INDEX_NAME=customer-feedback-bge-m3
PINECONE_NAMESPACE=ticket-interactions
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
SIMILARITY_THRESHOLD=0.78
